# Supabase project URL and publishable key (safe for browser use with Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only provider credentials. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional: server-only encryption key for future per-user provider credentials.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
APP_URL=
