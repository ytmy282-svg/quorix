# Supabase project URL and public anon key. Safe for browser use when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only encryption key for provider credentials (generate a strong 32-byte key).
# Never expose with NEXT_PUBLIC_ and never commit a real value.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
